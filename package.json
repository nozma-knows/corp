{
  "name": "corp-company-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "dev": "npm run build:client && tsx watch src/server/main.ts",
    "build:client": "node --import tsx scripts/build-client.ts",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx scripts/smoke-ui.ts",
    "start": "node dist/server/main.js",
    "password-hash": "node --import tsx src/server/main.ts password-hash",
    "session-secret": "node --import tsx src/server/main.ts session-secret",
    "backup": "node dist/server/main.js backup",
    "format": "prettier --write src tests scripts .railway *.json .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts .railway *.json .github/workflows/*.yml",
    "test:container": "node --import tsx scripts/smoke-container.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.6.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "prettier": "^3.9.9",
    "railway": "^3.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
