# Use your host's secret manager; never commit a real .env file.
CORP_ENV=staging
CORP_PUBLIC_ORIGIN=https://your-company.example
CORP_DB_PATH=/data/company.sqlite3
# Generate interactively with npm run password-hash. The $ separators are literal.
CORP_OPERATOR_PASSWORD_HASH=
# Generate with npm run session-secret. At least 32 random characters.
CORP_SESSION_SECRET=
PORT=8000
